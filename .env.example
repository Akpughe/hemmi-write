# ============================================================================
# HEMMI AI - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# SUPABASE
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================

# Paystack (for NGN and some USD payments)
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Optional, for webhook verification

# Stripe (for international USD payments)
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Get this from Stripe webhook settings

# ============================================================================
# APPLICATION
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Update to your production domain in production

# ============================================================================
# SEO & ANALYTICS
# ============================================================================
GOOGLE_SITE_VERIFICATION=your-google-verification-code  # Get from Google Search Console

# ============================================================================
# AI SERVICES
# ============================================================================
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
MISTRAL_API_KEY=your-mistral-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ============================================================================
# SEARCH & CONTENT
# ============================================================================
NEXT_PUBLIC_EXA_API_KEY=your-exa-api-key

# ============================================================================
# AWS (if using S3 for storage)
# ============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region

# ============================================================================
# OPTIONAL: CRON JOB SECRET
# For securing the subscription expiry cron endpoint
# ============================================================================
CRON_SECRET=your-random-secret-key-here

# ============================================================================
# PRODUCTION SETUP NOTES
# ============================================================================
#
# 1. Replace all test keys with live/production keys:
#    - Paystack: sk_live_xxx, pk_live_xxx
#    - Stripe: sk_live_xxx, pk_live_xxx
#
# 2. Update NEXT_PUBLIC_APP_URL to your production domain:
#    - Example: https://hemmi.ai
#
# 3. Configure webhook URLs in payment gateway dashboards:
#    - Paystack: https://yourdomain.com/api/webhooks/paystack
#      Events: charge.success, subscription.create, subscription.disable
#
#    - Stripe: https://yourdomain.com/api/webhooks/stripe
#      Events: checkout.session.completed, customer.subscription.*,
#              invoice.payment_succeeded, invoice.payment_failed
#
# 4. Test webhooks are reachable (not blocked by firewall/CORS)
#
# 5. Enable pg_cron extension in Supabase (Pro plan) OR
#    Set up external cron job to call /api/cron/expire-subscriptions
#
# ============================================================================
